---
import { CALLSIGN, NAME } from '../consts';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {NAME} ({CALLSIGN}). 73!
	<div class="tagline">
		Made in {'Canberra, ACT'} · Built with <a href="https://astro.build/">Astro</a> on Cloudflare
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.tagline {
		margin-top: 0.75em;
		font-size: 0.85em;
		opacity: 0.8;
	}
</style>
